(defpoll bluetooth_state
  :interval "2s"
  :initial `{"available":false,"powered":false,"connected":false,"audio":false,"adapter":""}`
  `@bluetooth@ status`)

(defwidget bluetooth []
  (eventbox
    :class `bluetooth ${bluetooth_state.powered ? "enabled" : "disabled"}`
    :visible {bluetooth_state.available}
    :cursor "pointer"
    :tooltip {open_popup == "bluetooth" ? "" : !bluetooth_state.powered ? "${bluetooth_state.adapter} · off"
      : bluetooth_state.connected ? "${bluetooth_state.adapter} · connected"
        : "${bluetooth_state.adapter} · on"}
    :onclick "@popupToggle@ bluetooth"
    :onmiddleclick "@bluetooth@ toggle"
    ;; The adapter is present either way, so an off radio keeps its control and
    ;; says it is off; hiding it would remove the only way to switch it back on.
    (bar-icon :icon {!bluetooth_state.powered ? "󰂲"
      : bluetooth_state.audio ? "󰂰"
        : bluetooth_state.connected ? "󰂱"
          : "󰂯"})))
