(defwidget popup-frame [kind]
  (box
    :class "popup ${kind} ${theme_mode}"
    :orientation "vertical"
    :space-evenly false
    (children)))

(defwidget popup-detail [name value]
  (box
    :class "popup-detail"
    :orientation "horizontal"
    :space-evenly false
    (label
      :class "popup-detail-name"
      :halign "start"
      :hexpand true
      :text {name})
    (label
      :class "popup-detail-value"
      :halign "end"
      :text {value})))

(defwidget popup-title [text]
  (label
    :class "popup-title"
    :halign "start"
    :text {text}))

(defwidget popup-section [title]
  (box
    :class "popup-section"
    :orientation "vertical"
    :space-evenly false
    :spacing @spacingSmall@
    (label
      :class "popup-section-title"
      :halign "start"
      :text {title})
    (children)))

;; One row shape for every dropdown entry, so menus stay visually identical.
(defwidget popup-action [action]
  (button
    :class "menu-action"
    :onclick {action}
    (children)))

;; Covers the usable area, which already excludes the bar's exclusive zone.
;; Popups map after it, so they stay on top while any click on the desktop
;; dismisses them. It never takes keyboard focus, which keeps bar buttons
;; clickable without moving the pointer first.
(defwindow popup-backdrop
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "100%"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable "none"
  :namespace "eww-popup-backdrop"
  (eventbox
    :onclick "@popupToggle@ close-all"
    :onrightclick "@popupToggle@ close-all"
    :onmiddleclick "@popupToggle@ close-all"
    (box :class "popup-backdrop")))

(defwindow popup-backdrop-secondary
  :monitor 1
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "100%"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable "none"
  :namespace "eww-popup-backdrop"
  (eventbox
    :onclick "@popupToggle@ close-all"
    :onrightclick "@popupToggle@ close-all"
    :onmiddleclick "@popupToggle@ close-all"
    (box :class "popup-backdrop")))
