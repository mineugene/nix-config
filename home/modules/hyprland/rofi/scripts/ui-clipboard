#!/bin/sh
set -u

if [ "$#" -ne 0 ]; then
    printf 'usage: ui-clipboard\n' >&2
    exit 2
fi

# shellcheck source=/dev/null
. "$THEMED_ROFI_LIB"
resolve_rofi_theme clipboard "${UI_DESKTOP_THEME:-desktop-theme}" "${UI_MONITOR_TOPOLOGY:-monitor-topology}"
cliphist=${UI_CLIPHIST:-cliphist}
rofi=${UI_ROFI:-rofi}
wl_copy=${UI_WL_COPY:-wl-copy}
selection_file=$(mktemp --tmpdir ui-clipboard.XXXXXX)
trap 'rm -f -- "$selection_file"' 0

"$cliphist" list |
    "$rofi" \
        -dmenu \
        -p Clipboard \
        -monitor "$ROFI_MONITOR" \
        -theme "$ROFI_THEME" \
        -no-custom > "$selection_file"

if [ ! -s "$selection_file" ]; then
    exit 0
fi

"$cliphist" decode < "$selection_file" | "$wl_copy"
