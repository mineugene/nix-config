/* Generated from mine.desktop.theme. */
* {
    surface-translucent: @surfaceTranslucent@;
    surface-hover: @surfaceHover@;
    foreground: @foreground@;
    muted: @muted@;
    accent: @accent@;
    border: @border@;

    font-interface-small: "@interfaceFontFamily@ @interfaceFontSizeSmall@";
    font-monospace: "@monospaceFontFamily@ @interfaceFontSize@";

    radius-card: @radiusCard@px;
    border-width: @borderWidth@px;

    spacing-small: @spacingSmall@px;
    spacing-normal: @spacingNormal@px;

    /* rofi cannot build a two-value padding out of two variables, so the
       pairs are named here rather than composed at each use. A row is padded
       one step in from its own text; a window takes the terminal's inset. */
    padding-row: @spacingSmall@px @spacingNormal@px;
    padding-window: @spacingNormal@px @spacingLarge@px;
}
