+pub fn new_window(type_: gtk::WindowType, x: i32, y: i32) -> Window {
+    let window = gtk::Window::new(type_);
+    // The private key and value type are used only through this module.
+    unsafe { window.set_data(POSITION_DATA, (x, y)) };
+    window
